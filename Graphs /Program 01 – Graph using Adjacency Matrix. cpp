
#include <iostream>
using namespace std;

int main() {
    int vertices, edges;

    cout << "Enter number of vertices: ";
    cin >> vertices;

    int adj[20][20] = {0};

    cout << "Enter number of edges: ";
    cin >> edges;

    cout << "Enter edges (u v):\n";

    for (int i = 0; i < edges; i++) {
        int u, v;
        cin >> u >> v;

        if (u >= 0 && u < vertices &&
            v >= 0 && v < vertices) {
            adj[u][v] = 1;
            adj[v][u] = 1;
        } else {
            cout << "Invalid edge!\n";
            i--;
        }
    }

    cout << "\nAdjacency Matrix:\n";

    for (int i = 0; i < vertices; i++) {
        for (int j = 0; j < vertices; j++) {
            cout << adj[i][j] << " ";
        }
        cout << endl;
    }

    return 0;
}
